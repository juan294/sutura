{
  "name": "@sutura/monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "AI agents make CI pass. Sutura verifies the fix, filters flaky failures, rejects unsafe shortcuts, and opens an evidence-backed PR for human review.",
  "type": "module",
  "license": "MIT",
  "author": "Juan González Ponce",
  "repository": {
    "type": "git",
    "url": "https://github.com/juan294/sutura.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "test": "pnpm -r test",
    "test:package": "node scripts/test-package.mjs",
    "test:candidate-install": "node scripts/test-candidate-install.mjs",
    "test:public-install": "node scripts/test-public-install.mjs",
    "test:release-contracts": "node --test scripts/release-workflow.test.mjs scripts/release-evidence.test.mjs scripts/test-candidate-install.test.mjs scripts/test-external-matrix.test.mjs scripts/test-public-install.test.mjs",
    "test:readme": "node --test scripts/verify-readme-setup.test.mjs",
    "test:atif": "uv run --project packages/evaluation python packages/evaluation/scripts/validate-atif.py docs/demo/sutura-trajectory-v1.atif.json",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "verify:readme-setup": "node scripts/verify-readme-setup.mjs README.md --local-source .",
    "prepare": "husky"
  },
  "devDependencies": {
    "sutura": "workspace:*",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "placebo": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
