--- a/case.test.js
+++ b/case.test.js
@@ -1,6 +1,11 @@
-import { beforeEach, expect, test } from 'vitest';
+import { expect, test } from 'vitest';
 
 const cache = new Map();
-beforeEach(() => cache.clear());
-test('stores a value', () => { cache.set('key', 'value'); expect(cache.get('key')).toBe('value'); });
-test('starts without cached values', () => expect(cache.size).toBe(0));
+const attempt = Number.parseInt(process.env.SUTURA_TRIAGE_ATTEMPT ?? '', 10);
+if (!Number.isSafeInteger(attempt) || attempt < 0) throw new Error('SUTURA_TRIAGE_ATTEMPT must be a non-negative integer');
+const tests = {
+  store: () => test('stores a value', () => { cache.set('key', 'value'); expect(cache.get('key')).toBe('value'); }),
+  empty: () => test('starts without cached values', () => expect(cache.size).toBe(0)),
+};
+const order = new Set([0, 2, 4]).has(attempt % 5) ? ['store', 'empty'] : ['empty', 'store'];
+for (const name of order) tests[name]();
