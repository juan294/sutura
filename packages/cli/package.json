{
  "name": "sutura",
  "version": "0.1.1",
  "description": "Install and run verified self-healing CI for GitHub Actions.",
  "type": "module",
  "license": "MIT",
  "author": "Juan González Ponce",
  "bin": {
    "sutura": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juan294/sutura.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/juan294/sutura#readme",
  "bugs": {
    "url": "https://github.com/juan294/sutura/issues"
  },
  "keywords": [
    "ci",
    "github-actions",
    "ai",
    "repair",
    "testing"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @sutura/core build && pnpm run typecheck && node scripts/bundle.mjs",
    "bundle": "node scripts/bundle.mjs",
    "lint": "eslint src scripts",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@sutura/core": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
