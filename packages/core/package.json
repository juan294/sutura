{
  "name": "@sutura/core",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "exports": {
    "./grounding-summary": {
      "types": "./src/report/grounding-summary.ts",
      "development": "./src/report/grounding-summary.ts",
      "default": "./dist/report/grounding-summary.js"
    },
    "./grounding-evidence": {
      "types": "./src/decisions/grounding-evidence.ts",
      "development": "./src/decisions/grounding-evidence.ts",
      "default": "./dist/decisions/grounding-evidence.js"
    },
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./recovery-summary": {
      "types": "./src/report/recovery-summary.ts",
      "development": "./src/report/recovery-summary.ts",
      "default": "./dist/report/recovery-summary.js"
    },
    "./audit-status": {
      "types": "./src/report/audit-status.ts",
      "development": "./src/report/audit-status.ts",
      "default": "./dist/report/audit-status.js"
    },
    "./semantic-evidence": {
      "types": "./src/decisions/evidence.ts",
      "development": "./src/decisions/evidence.ts",
      "default": "./dist/decisions/evidence.js"
    },
    "./semantic-summary": {
      "types": "./src/report/semantic-summary.ts",
      "development": "./src/report/semantic-summary.ts",
      "default": "./dist/report/semantic-summary.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --maxWorkers=1 --testTimeout=60000 --coverage.enabled --coverage.provider=v8 --coverage.reporter=json --coverage.reportsDirectory=../../coverage/core",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "p-limit": "^7.3.3",
    "semver": "7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/semver": "7.8.0"
  }
}
