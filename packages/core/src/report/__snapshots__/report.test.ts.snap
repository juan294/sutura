<body class="outcome-gave-up">
  <main class="case-file">
    <header class="docket">
      <div>
        <p class="eyebrow">Sutura · Surgical CI case file</p>
        <h1>Case run-gave-up-031</h1>
        <p class="case-meta"><code>acme/search</code> · typecheck · 81% confidence</p>
      </div>
      <div class="verdict">
        <small>Operative verdict</small>
        <strong>NO PATCH HELD</strong>
        <p>No candidate is safe to merge. Inspect the diagnosis and start a new repair cycle with more evidence.</p>
      </div>
    </header>
    <section class="sheet diagnosis" aria-labelledby="diagnosis-title">
    <div class="section-label"><span>D</span><h2 id="diagnosis-title">Diagnosis</h2></div>
    <div class="section-body">
      <div class="diagnostic-lockup">
        <strong>typecheck</strong>
        <span>81% confidence</span>
      </div>
      <dl class="facts">
        <div><dt>Failing command</dt><dd><code>pnpm typecheck</code></dd></div>
        <div><dt>Error specimen</dt><dd>Type &#39;SearchRow&#39; does not satisfy constraint &#39;Record&lt;string, Scalar&gt;&#39;</dd></div>
      </dl>
      <ul class="signals"><li>generic constraint mismatch</li><li>failure starts after schema regeneration</li></ul>
    </div>
  </section>
    <section class="sheet triage" aria-labelledby="triage-title">
    <div class="section-label"><span>T</span><h2 id="triage-title">Triage</h2></div>
    <div class="section-body"><p class="triage-reading">Reproduced 5/5 across forked sandbox states — real.</p></div>
  </section>
    <section class="sheet procedure" aria-labelledby="procedure-title">
    <div class="section-label"><span>P</span><h2 id="procedure-title">Procedure</h2></div>
    <div class="section-body">
      <p class="micro-label">Forked sandbox timeline</p>
      <ol class="suture-line" aria-label="Candidate sandbox operations"><li class="rolled">
        <span class="knot" aria-hidden="true"></span>
        <span class="op">OP 01</span>
        <strong>candidate-a</strong>
        <small>img-gave-up-a · exit 2</small>
      </li><li class="rolled">
        <span class="knot" aria-hidden="true"></span>
        <span class="op">OP 02</span>
        <strong>candidate-b</strong>
        <small>img-gave-up-b · exit 2</small>
      </li></ol>
      <div class="table-wrap"><table>
        <thead><tr><th>Candidate</th><th>Strategy</th><th>Held?</th><th>Operative note</th></tr></thead>
        <tbody><tr>
        <th scope="row">candidate-a</th>
        <td>Narrow the generated row at the call site</td>
        <td><span class="mini-verdict fail">ROLLED BACK</span></td>
        <td>Rolled back; verification exited 2</td>
      </tr><tr>
        <th scope="row">candidate-b</th>
        <td>Regenerate the schema with the prior generator</td>
        <td><span class="mini-verdict fail">ROLLED BACK</span></td>
        <td>Rolled back; verification exited 2</td>
      </tr></tbody>
      </table></div>
      <div class="diff-stack"><p class="micro-label">Candidate tissue samples</p><details >
        <summary>candidate-a <span>rolled back</span></summary>
        <pre><code>--- a/src/search.ts
+++ b/src/search.ts
@@ -8 +8 @@
-query&lt;SearchRow&gt;();
+query&lt;SearchRow &amp; Record&lt;string, Scalar&gt;&gt;();</code></pre>
      </details><details >
        <summary>candidate-b <span>rolled back</span></summary>
        <pre><code>--- a/package.json
+++ b/package.json
@@ -12 +12 @@
-&quot;schema-gen&quot;: &quot;5.0.0&quot;
+&quot;schema-gen&quot;: &quot;4.9.2&quot;</code></pre>
      </details></div>
    </div>
  </section><section class="sheet pathology" aria-labelledby="pathology-title">
      <div class="section-label"><span>P</span><h2 id="pathology-title">Pathology</h2></div>
      <div class="section-body"><p class="empty-reading"><strong>NOT RUN</strong> No candidate survived for adversarial audit.</p></div>
    </section><section class="sheet discharge" aria-labelledby="discharge-title">
    <div class="section-label"><span>D</span><h2 id="discharge-title">Discharge</h2></div>
    <div class="section-body">
      <div class="discharge-grid">
        <div><span>Diff summary</span><strong>No candidate patch survived.</strong></div>
